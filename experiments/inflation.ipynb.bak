    "            data_index = 'ambient'\n",
    "            \n",
    "            #z = all_models['true'][dim][var][data_index][MANIFOLD_DATA_WITH_NOISE].squeeze(1)\n",
    "            z = model_data[dim][var][data_index][Z_IDX][:, 3]\n",
    "            #print(z.shape)\n",
    "            z_sort = np.argsort(z)\n",
    "            z = z[z_sort]\n",
    "            all_scores = []\n",
    "            \n",
    "            llh = model_data[dim][var][data_index][VOLUME_IDX][z_sort]\n",
